<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- One launcher icon per native mode so the trial needs no adb extras.
         The main icon (butterfly-trial) is flutter_only. -->
    <application>
        <activity-alias
            android:name=".LatencyLabInk"
            android:targetActivity=".LatencyLabActivity"
            android:label="trial: ink"
            android:exported="true">
            <meta-data
                android:name="dev.linwood.butterfly.extra.STYLUS_LATENCY_MODE"
                android:value="ink_prediction_off" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LatencyLabInkPredict"
            android:targetActivity=".LatencyLabActivity"
            android:label="trial: ink+predict"
            android:exported="true">
            <meta-data
                android:name="dev.linwood.butterfly.extra.STYLUS_LATENCY_MODE"
                android:value="ink_prediction_on" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LatencyLabShared"
            android:targetActivity=".LatencyLabActivity"
            android:label="trial: shared"
            android:exported="true">
            <meta-data
                android:name="dev.linwood.butterfly.extra.STYLUS_LATENCY_MODE"
                android:value="shared_geometry" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
